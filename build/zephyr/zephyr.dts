			compatible = "fixed-clock";   /* in zephyr/dts/arm/st/f1/stm32f1.dtsi:86 */
			clock-frequency = < 0x9c40 >; /* in zephyr/dts/arm/st/f1/stm32f1.dtsi:87 */
			status = "disabled";          /* in zephyr/dts/arm/st/f1/stm32f1.dtsi:88 */
		};

		/* node '/clocks/pll' defined in zephyr/dts/arm/st/f1/stm32f1.dtsi:91 */
		pll: pll {
			#clock-cells = < 0x0 >;              /* in zephyr/dts/arm/st/f1/stm32f1.dtsi:92 */
			compatible = "st,stm32f1-pll-clock"; /* in zephyr/dts/arm/st/f1/stm32f1.dtsi:93 */
			mul = < 0x9 >;                       /* in zephyr/boards/others/stm32_min_dev/stm32_min_dev.dts:43 */
			clocks = < &clk_hse >;               /* in zephyr/boards/others/stm32_min_dev/stm32_min_dev.dts:44 */
			status = "okay";                     /* in zephyr/boards/others/stm32_min_dev/stm32_min_dev.dts:45 */
			phandle = < 0x3 >;                   /* in zephyr/boards/others/stm32_min_dev/stm32_min_dev.dts:49 */
		};
	};

	/* node '/mcos' defined in zephyr/dts/arm/st/f1/stm32f1.dtsi:98 */
	mcos {

