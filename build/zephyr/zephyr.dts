		io-channels = < &adc1 0x10 >; /* in zephyr/dts/arm/st/f1/stm32f1.dtsi:400 */
		status = "disabled";          /* in zephyr/dts/arm/st/f1/stm32f1.dtsi:401 */
		avgslope = "4.3";             /* in zephyr/dts/arm/st/f1/stm32f1.dtsi:402 */
		v25 = < 0x596 >;              /* in zephyr/dts/arm/st/f1/stm32f1.dtsi:403 */
		ntc;                          /* in zephyr/dts/arm/st/f1/stm32f1.dtsi:404 */
	};

	/* node '/smbus1' defined in zephyr/dts/arm/st/f1/stm32f1.dtsi:407 */
	smbus1: smbus1 {
