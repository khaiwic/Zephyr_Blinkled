		#phy-cells = < 0x0 >;         /* in zephyr/dts/arm/st/f1/stm32f103X6.dtsi:49 */
		phandle = < 0x13 >;           /* in zephyr/dts/arm/st/f1/stm32f103X6.dtsi:34 */
