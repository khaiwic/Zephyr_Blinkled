		#address-cells = < 0x1 >;      /* in zephyr/dts/arm/st/f1/stm32f103X8.dtsi:90 */
		#size-cells = < 0x0 >;         /* in zephyr/dts/arm/st/f1/stm32f103X8.dtsi:91 */
		i2c = < &i2c2 >;               /* in zephyr/dts/arm/st/f1/stm32f103X8.dtsi:92 */
