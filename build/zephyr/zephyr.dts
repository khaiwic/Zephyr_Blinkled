			gpios = < &gpioc 0xd 0x1 >; /* in zephyr/boards/others/stm32_min_dev/stm32_min_dev_stm32f103x8_blue.overlay:13 */
		};

		/* node '/leds/led_pc13' defined in ../Zephyr_Prj/Blink_led/boards/stm32_min_dev_blue.overlay:8 */
		my_led: led_pc13 {
